20,292]" drawing-order="2" hint="" /><node index="3" text="" resource-id="" class="android.widget.TextView" package="cn.nanoturtle.rootmys9280" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[120,315][504,375]" drawing-order="3" hint="" /><node index="4" text="• Manager 显示“未安装”时，强制停止后重新打开即可" resource-id="" class="android.widget.TextView" package="cn.nanoturtle.rootmys9280" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[504,315][1320,441]" drawing-order="4" hint="" /><node index="5" text="" resource-id="" class="android.widget.TextView" package="cn.nanoturtle.rootmys9280" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[120,464][504,524]" drawing-order="5" hint="" /><node index="6" text="• 模块安装在 /data/adb（跨重启保留）" resource-id="" class="android.widget.TextView" package="cn.nanoturtle.rootmys9280" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[504,464][1320,530]" drawing-order="6" hint="" /><node index="7" text="" resource-id="" class="android.widget.TextView" package="cn.nanoturtle.rootmys9280" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[120,553][504,613]" drawing-order="7" hint="" /><node index="8" text="• 运行期间建议熄屏，降低内核竞态概率" resource-id="" class="android.widget.TextView" package="cn.nanoturtle.rootmys9280" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[504,553][1320,619]" drawing-order="8" hint="" /></node><node index="1" text="常见问题 FAQ" resource-id="" class="android.widget.TextView" package="cn.nanoturtle.rootmys9280" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[60,724][418,814]" drawing-order="1" hint="" /><node index="2" text="" resource-id="" class="android.view.View" package="cn.nanoturtle.rootmys9280" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[60,844][1380,2640]" drawing-order="2" hint=""><node index="0" text="Q: 为什么会卡死/重启？是正常现象吗？" resource-id="" class="android.widget.TextView" package="cn.nanoturtle.rootmys9280" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[120,904][910,970]" drawing-order="0" hint="" /><node index="1" text="A: 正常。exploit 通过破坏内核内存提权，命中关键结构就会 oops 重启。官方参考实现同样需要多次尝试（S928U1 验证时第 2 轮 attempt 4/24 才成功）。失败/重启后重新运行即可。" resource-id="" class="android.widget.TextView" package="cn.nanoturtle.rootmys9280" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[120,978][1320,1224]" drawing-order="1" hint="" /><node index="2" text="Q: 每次重启后都要重新 Root 吗？" resource-id="" class="android.widget.TextView" package="cn.nanoturtle.rootmys9280" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[120,1262][794,1328]" drawing-order="2" hint="" /><node index="3" text="A: 是。bootloader 是锁定的，无法持久化写入内核模块。每次重启后运行一次“开始 Root”，再强制停止并重开 KernelSU Manager 即可。" resource-id="" class="android.widget.TextView" package="cn.nanoturtle.rootmys9280" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[120,1336][1320,1522]" drawing-order="3" hint="" /><node index="4" text="Q: 运行期间为什么要熄屏？" resource-id="" class="android.widget.TextView" package="cn.nanoturtle.rootmys9280" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[120,1560][669,1626]" drawing-order="4" hint="" /><node index="5" text="A: 屏幕刷新会产生显示驱动 work，可能与 exploit 注入的内核 work 竞争，是概率性崩溃的最大来源。熄屏后显示驱动停止，成功率显著提高。" resource-id="" class="android.widget.TextView" package="cn.nanoturtle.rootmys9280" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[120,1634][1320,1820]" drawing-order="5" hint="" /><node index="6" text="Q: KernelSU Manager 显示“未安装”怎么办？" resource-id="" class="android.widget.TextView" package="cn.nanoturtle.rootmys9280" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[120,1858][1032,1924]" drawing-order="6" hint="" /><node index="7" text="A: 驱动已加载但 Manager 首次检测可能失败。强制停止 Manager 后重新打开，应显示“工作中 &lt;LKM&gt; [越狱模式]”。" resource-id="" class="android.widget.TextView" package="cn.nanoturtle.rootmys9280" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[120,1932][1320,2058]" drawing-order="7" hint="" /><node index="8" text="Q: 锁 bootloader 能 Root 吗？KNOX 会怎样？" resource-id="" class="android.widget.TextView" package="cn.nanoturtle.rootmys9280" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[120,2096][1056,2162]" drawing-order="8" hint="" /><node index="9" text="A: 本工具利用内核漏洞（CVE-2026-43499）免解锁提权，bootloader 保持锁定。KNOX e-fuse 之前已被熔断（0x1），无法恢复，但 Secure Folder 等可用 KnoxPatch 恢复。" resource-id="" class="android.widget.TextView" package="cn.nanoturtle.rootmys9280" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[120,2170][1320,2416]" drawing-order="9" hint="" /><node index="10" text="Q: KnoxPatch / Secure Folder 怎么用？" resource-id="" class="android.widget.TextView" package="cn.nanoturtle.rootmys9280" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[120,2454][941,2520]" drawing-order="10" hint="" /><node index="11" text="A: 在 KernelSU Manager 安装 Zygisk-Next 和 LSPosed 模块，安装 KnoxPatch APK，在 LSPosed 里启用后重启 Zygote，打开 KnoxPatch 勾选 Secure Folder 即可。" resource-id="" class="android.widget.TextView" package="cn.nanoturtle.rootmys9280" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[120,2528][1320,2640]" drawing-order="11" hint="" /></node></node><node index="1" text="" resource-id="" class="android.view.View" package="cn.nanoturtle.rootmys9280" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,2640][1440,3120]" drawing-order="1" hint=""><node index="0" text="" resource-id="" class="android.view.View" package="cn.nanoturtle.rootmys9280" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,2640][1440,2940]" drawing-order="0" hint=""><node index="0" text="" resource-id="" class="android.view.View" package="cn.nanoturtle.rootmys9280" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,2640][460,2940]" drawing-order="0" hint=""><node index="1" text="" resource-id="" class="android.view.View" package="cn.nanoturtle.rootmys9280" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[140,2760][320,2940]" drawing-order="1" hint=""><node index="0" text="首页" resource-id="" class="android.widget.TextView" package="cn.nanoturtle.rootmys9280" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[185,2817][274,2883]" drawing-order="0" hint="" /></node><node index="2" text="" resource-id="" class="android.view.View" package="cn.nanoturtle.rootmys9280" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable=